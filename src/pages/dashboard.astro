---
import BaseLayout from '../layouts/BaseLayout.astro';

const TOKEN = process.env.BUFET_TOKEN || 'bufet';
const configJson = JSON.stringify({ token: TOKEN });
---

<BaseLayout title="dashboard — bufet.lol">
  <style is:global>
    .dash-wrap { position: relative; z-index: 2; max-width: 1100px; margin: 0 auto; padding: 2rem 1.5rem 4rem; width: 100%; }

    .dash-title { font-family: 'Fredoka', sans-serif; font-size: clamp(2rem,5vw,3rem); font-weight: 700; color: #fff; text-shadow: 3px 3px 0 var(--purple); text-align: center; margin-bottom: .25rem; transform: rotate(-1deg); }
    .dash-sub { text-align: center; color: rgba(255,255,255,.8); font-weight: 700; margin-bottom: 2rem; }

    /* auth */
    #auth-screen { text-align: center; padding-top: 15vh; }
    #auth-screen .lock { font-size: 4rem; margin-bottom: 1rem; filter: drop-shadow(2px 2px 0 rgba(0,0,0,.1)); }
    #auth-screen p { color: rgba(255,255,255,.85); font-weight: 700; margin-bottom: 1.2rem; font-size: 1.1rem; }
    #auth-screen input {
      border: 3px solid var(--purple); border-radius: 999px; padding: .7rem 1.4rem; font-size: 1rem;
      font-family: inherit; font-weight: 700; background: rgba(255,255,255,.85); outline: none;
      text-align: center; width: 240px; transition: border-color .2s, box-shadow .2s;
    }
    #auth-screen input:focus { border-color: var(--ocean); box-shadow: 0 0 0 4px rgba(162,210,255,.3); }
    #auth-screen .btn {
      display: block; margin: .8rem auto 0; border: none; border-radius: 999px; padding: .6rem 2rem;
      font-family: 'Fredoka', sans-serif; font-size: 1.1rem; font-weight: 600;
      background: var(--rose); color: #fff; cursor: pointer;
      transition: transform .2s, box-shadow .2s; box-shadow: 0 4px 12px rgba(0,0,0,.1);
    }
    #auth-screen .btn:hover { transform: scale(1.05) rotate(-1deg); box-shadow: 0 6px 20px rgba(0,0,0,.15); }
    #auth-error { color: #d44; font-weight: 700; margin-top: .5rem; display: none; }

    #dash-screen { display: none; }

    .tabs { display: flex; gap: .5rem; margin-bottom: 1.5rem; }
    .tab {
      border: none; border-radius: 999px; padding: .5rem 1.5rem;
      font-family: 'Fredoka', sans-serif; font-size: 1rem; font-weight: 600;
      cursor: pointer; transition: transform .2s ease, box-shadow .2s ease;
      background: rgba(255,255,255,.3); color: #fff; box-shadow: 0 2px 8px rgba(0,0,0,.06);
    }
    .tab:hover { transform: scale(1.05) rotate(-1deg); box-shadow: 0 4px 16px rgba(0,0,0,.12); }
    .tab.active { background: var(--rose); color: #fff; box-shadow: 0 4px 12px rgba(0,0,0,.1); transform: none; }
    .tab-content { display: none; }
    .tab-content.active { display: block; }

    .toolbar {
      display: flex; align-items: center; gap: .75rem; flex-wrap: wrap;
      margin-bottom: 1.2rem; padding-bottom: 1rem;
      border-bottom: 3px dashed rgba(255,255,255,.4);
    }
    .toolbar h2 { font-family: 'Fredoka', sans-serif; font-size: 1.4rem; color: #fff; flex: 1; }

    .btn {
      border: none; border-radius: 999px; padding: .5rem 1.2rem;
      font-family: 'Fredoka', sans-serif; font-size: .9rem; font-weight: 600;
      cursor: pointer; transition: transform .2s cubic-bezier(.34,1.56,.64,1), box-shadow .2s ease;
      box-shadow: 0 4px 12px rgba(0,0,0,.1); text-decoration: none; display: inline-flex;
      align-items: center; gap: .35rem;
    }
    .btn:hover { transform: scale(1.05) rotate(-1deg); box-shadow: 0 6px 20px rgba(0,0,0,.15); }
    .btn:active { transform: scale(.95); }
    .btn-rose   { background: var(--rose); color: #fff; }
    .btn-ocean  { background: var(--ocean); color: #fff; }
    .btn-sky    { background: var(--sky); color: #444; }
    .btn-purple { background: var(--purple); color: #fff; }
    .btn-out    { background: rgba(255,255,255,.3); color: #fff; }
    .btn-sm { padding: .3rem .7rem; font-size: .8rem; }

    /* ─── photo grid ─── */
    .photo-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
      gap: 1.25rem;
      width: 100%;
      min-width: 0;
    }

    .photo-card {
      background: #fff; border-radius: 18px; overflow: hidden;
      box-shadow: 0 6px 24px rgba(0,0,0,.1), 0 0 0 3px rgba(255,255,255,.5);
      transition: transform .25s cubic-bezier(.34,1.56,.64,1), box-shadow .25s ease;
      display: flex; flex-direction: column;
      width: 100%; max-width: 100%; min-width: 0;
    }
    .photo-card:hover { transform: scale(1.02) rotate(-.5deg); box-shadow: 0 12px 40px rgba(0,0,0,.16), 0 0 0 3px rgba(255,255,255,.5); }

    .photo-card .thumb-wrap {
      position: relative; width: 100%; padding-top: 66%;
      background: var(--pink); overflow: hidden;
    }
    .photo-card .thumb-wrap img {
      position: absolute; inset: 0; width: 100%; height: 100%;
      object-fit: cover; border-bottom: 3px solid var(--rose);
      transition: transform .3s ease;
    }
    .photo-card:hover .thumb-wrap img { transform: scale(1.08); }

    .photo-card .body {
      padding: .85rem 1rem 1rem; flex: 1;
      display: flex; flex-direction: column; gap: .5rem;
      min-width: 0;
    }

    .photo-card .body .cap {
      font-weight: 700; font-size: 1rem; color: #333;
      border: none; background: transparent; font-family: inherit;
      width: 100%; outline: none; padding: .3rem .5rem;
      border-radius: 8px;
      border: 2px solid transparent; transition: border-color .2s, background .2s;
      overflow: hidden; text-overflow: ellipsis;
    }
    .photo-card .body .cap:focus {
      border-color: var(--sky);
      background: rgba(189,224,254,.15);
    }

    .photo-card .body .meta {
      font-size: .75rem; color: #bbb; word-break: break-all; line-height: 1.3;
      padding: 0 .3rem; overflow: hidden; text-overflow: ellipsis;
    }

    .photo-card .actions {
      display: flex; gap: .4rem; margin-top: auto;
      padding-top: .6rem; border-top: 2px dashed rgba(0,0,0,.06);
    }

    /* ─── add form ─── */
    .add-form {
      background: rgba(255,255,255,.88); border-radius: 18px;
      padding: 1.2rem; margin-bottom: 1.25rem;
      display: none; flex-wrap: wrap; gap: .75rem; align-items: flex-end;
      box-shadow: 0 4px 16px rgba(0,0,0,.06);
    }
    .add-form.open { display: flex; }

    .add-form .field { display: flex; flex-direction: column; gap: .25rem; flex: 1; min-width: 140px; }
    .add-form .field label { font-weight: 700; font-size: .8rem; color: rgba(0,0,0,.4); text-transform: uppercase; letter-spacing: .05em; }
    .add-form input, .add-form .file-label {
      border: 2px solid var(--sky); border-radius: 10px; padding: .5rem .8rem;
      font-size: .9rem; font-family: inherit; background: #fff; outline: none; width: 100%;
    }
    .add-form input:focus { border-color: var(--ocean); }
    .add-form input[type="file"] { display: none; }
    .add-form .file-label { cursor: pointer; display: flex; align-items: center; gap: .4rem; color: #888; }
    .add-form .file-label.has-file { border-color: var(--ocean); color: #333; }

    /* ─── skeleton ─── */
    .skeleton-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
      gap: 1.25rem;
      width: 100%;
    }
    .skeleton-card {
      background: rgba(255,255,255,.5);
      border-radius: 18px; overflow: hidden;
      width: 100%;
    }
    .skeleton-card .sk-thumb {
      width: 100%; padding-top: 66%;
      background: linear-gradient(135deg, rgba(255,255,255,.3), rgba(255,255,255,.05));
      animation: sk-shimmer 1.5s ease-in-out infinite;
    }
    .skeleton-card .sk-body {
      padding: 1rem;
      display: flex; flex-direction: column; gap: .6rem;
    }
    .skeleton-card .sk-line {
      height: 14px; border-radius: 999px;
      background: linear-gradient(90deg, rgba(255,255,255,.3), rgba(255,255,255,.05));
      animation: sk-shimmer 1.5s ease-in-out infinite;
    }
    .skeleton-card .sk-line:last-child { width: 60%; }

    @keyframes sk-shimmer {
      0%, 100% { opacity: .6; }
      50% { opacity: 1; }
    }

    /* thoughts */
    .thoughts-area {
      width: 100%; min-height: 300px; border: 3px solid var(--sky); border-radius: 16px;
      padding: 1rem; font-family: 'Nunito', sans-serif; font-size: 1rem;
      background: rgba(255,255,255,.85); outline: none; resize: vertical;
      line-height: 1.8; box-shadow: 0 4px 16px rgba(0,0,0,.06);
    }
    .thoughts-area:focus { border-color: var(--ocean); box-shadow: 0 0 0 4px rgba(162,210,255,.3); }
    .thoughts-hint { color: rgba(255,255,255,.6); font-size: .85rem; margin-top: .4rem; font-weight: 600; }

    .toast {
      position: fixed; z-index: 30; bottom: 5rem; left: 50%; transform: translateX(-50%);
      background: rgba(255,255,255,.9); backdrop-filter: blur(4px);
      color: #444; font-weight: 700; padding: .6rem 1.5rem;
      border-radius: 999px; box-shadow: 0 4px 16px rgba(0,0,0,.1);
      opacity: 0; transition: opacity .4s; pointer-events: none; font-size: .95rem;
    }
    .toast.show { opacity: 1; }
    .toast.error { background: rgba(255,200,200,.9); color: #b44; }

    .back-link {
      display: inline-flex; align-items: center; gap: .4rem;
      color: rgba(255,255,255,.8); text-decoration: none; font-weight: 700; font-size: .95rem;
      margin-bottom: 1.5rem; transition: gap .2s, color .2s;
    }
    .back-link:hover { gap: .7rem; color: #fff; }

    .empty-state {
      grid-column: 1 / -1;
      text-align: center; padding: 3rem 1rem;
      color: rgba(255,255,255,.7); font-weight: 700; font-size: 1.1rem;
    }

    /* ─── f l u f f   t o u c h e s ─── */
    @keyframes float-in {
      0% { opacity: 0; transform: translateY(20px) scale(.95); }
      100% { opacity: 1; transform: translateY(0) scale(1); }
    }

    .photo-card { animation: float-in .4s cubic-bezier(.34,1.56,.64,1) both; }
    .photo-card:nth-child(2) { animation-delay: .05s; }
    .photo-card:nth-child(3) { animation-delay: .1s; }
    .photo-card:nth-child(4) { animation-delay: .15s; }
    .photo-card:nth-child(5) { animation-delay: .2s; }
    .photo-card:nth-child(6) { animation-delay: .25s; }

    @media (max-width: 640px) {
      .photo-grid { grid-template-columns: 1fr; }
      .add-form { flex-direction: column; }
      .add-form .field { min-width: 100%; }
    }
  </style>

  <script id="dash-data" type="application/json" set:html={configJson}></script>

  <div class="dash-wrap">
    <a href="/" class="back-link">← back to garbage</a>

    <div id="auth-screen">
      <div class="lock">🔐</div>
      <p>gimme the secret word</p>
      <input id="token-input" type="password" placeholder="token..." autocomplete="off" />
      <button class="btn" id="token-btn">enter</button>
      <div id="auth-error">nope, try again 🤨</div>
    </div>

    <div id="dash-screen">
      <div class="dash-title">⚙ dashboard</div>
      <div class="dash-sub">manage the photo garbage</div>

      <div class="tabs">
        <button class="tab active" data-tab="photos">📸 photos</button>
        <button class="tab" data-tab="thoughts">💭 thoughts</button>
      </div>

      <!-- PHOTOS -->
      <div class="tab-content active" id="tab-photos">
        <div class="toolbar">
          <h2>photos <span id="photo-count"></span></h2>
          <button class="btn btn-rose" id="add-toggle">+ add</button>
          <button class="btn btn-ocean" id="save-photos-btn">💾 save</button>
          <button class="btn btn-purple" id="export-btn">↓ export</button>
          <button class="btn btn-out" id="logout-btn">logout</button>
        </div>

        <div class="add-form" id="add-form">
          <div class="field">
            <label>photo</label>
            <label class="file-label" id="file-label" for="file-input">📁 choose file...</label>
            <input type="file" id="file-input" accept="image/*" />
          </div>
          <div class="field">
            <label>caption</label>
            <input id="add-cap" placeholder="caption" />
          </div>
          <button class="btn btn-sky" id="add-btn" style="align-self:flex-end">add</button>
        </div>

        <!-- skeleton shown while loading -->
        <div class="skeleton-grid" id="skeleton-grid">
          <div class="skeleton-card"><div class="sk-thumb"></div><div class="sk-body"><div class="sk-line"></div><div class="sk-line"></div></div></div>
          <div class="skeleton-card"><div class="sk-thumb"></div><div class="sk-body"><div class="sk-line"></div><div class="sk-line"></div></div></div>
          <div class="skeleton-card"><div class="sk-thumb"></div><div class="sk-body"><div class="sk-line"></div><div class="sk-line"></div></div></div>
          <div class="skeleton-card"><div class="sk-thumb"></div><div class="sk-body"><div class="sk-line"></div><div class="sk-line"></div></div></div>
          <div class="skeleton-card"><div class="sk-thumb"></div><div class="sk-body"><div class="sk-line"></div><div class="sk-line"></div></div></div>
          <div class="skeleton-card"><div class="sk-thumb"></div><div class="sk-body"><div class="sk-line"></div><div class="sk-line"></div></div></div>
        </div>

        <div class="photo-grid" id="photo-grid" style="display:none"></div>
      </div>

      <!-- THOUGHTS -->
      <div class="tab-content" id="tab-thoughts">
        <div class="toolbar">
          <h2>thoughts <span id="thought-count"></span></h2>
          <button class="btn btn-ocean" id="save-thoughts-btn">💾 save</button>
        </div>
        <textarea class="thoughts-area" id="thoughts-area" placeholder="one thought per line..."></textarea>
        <div class="thoughts-hint">one thought per line — shows up at the bottom of the main page</div>
      </div>
    </div>

    <div class="toast" id="toast"></div>
  </div>

  <script>
    (() => {
      const cfg = JSON.parse(document.getElementById('dash-data').textContent);
      const EMBEDDED_TOKEN = cfg.token;
      let photos = [];
      let thoughts = [];

      const STORAGE_KEY = 'bufet_token';
      const PHOTOS_KEY = 'bufet_photos';
      const THOUGHTS_KEY = 'bufet_thoughts';

      const authScreen = document.getElementById('auth-screen');
      const dashScreen = document.getElementById('dash-screen');
      const tokenInput = document.getElementById('token-input');
      const tokenBtn = document.getElementById('token-btn');
      const authError = document.getElementById('auth-error');
      const photoGrid = document.getElementById('photo-grid');
      const skeletonGrid = document.getElementById('skeleton-grid');
      const photoCount = document.getElementById('photo-count');
      const thoughtCount = document.getElementById('thought-count');
      const thoughtsArea = document.getElementById('thoughts-area');

      const addToggle = document.getElementById('add-toggle');
      const addForm = document.getElementById('add-form');
      const fileInput = document.getElementById('file-input');
      const fileLabel = document.getElementById('file-label');
      const addCap = document.getElementById('add-cap');
      const addBtn = document.getElementById('add-btn');

      const savePhotosBtn = document.getElementById('save-photos-btn');
      const saveThoughtsBtn = document.getElementById('save-thoughts-btn');
      const exportBtn = document.getElementById('export-btn');
      const logoutBtn = document.getElementById('logout-btn');
      const toast = document.getElementById('toast');

      const tabBtns = document.querySelectorAll('.tab[data-tab]');
      const tabContents = {
        photos: document.getElementById('tab-photos'),
        thoughts: document.getElementById('tab-thoughts'),
      };

      let toastTimer;
      function showToast(msg, isError) {
        toast.textContent = msg;
        toast.className = 'toast' + (isError ? ' error' : '');
        toast.classList.add('show');
        clearTimeout(toastTimer);
        toastTimer = setTimeout(() => toast.classList.remove('show'), 3000);
      }

      function getToken() { return localStorage.getItem(STORAGE_KEY); }
      function setToken(t) { localStorage.setItem(STORAGE_KEY, t); }
      function clearToken() { localStorage.removeItem(STORAGE_KEY); }

      let authed = false;
      if (getToken()) authed = true;

      if (authed) { authScreen.style.display = 'none'; dashScreen.style.display = 'block'; init(); }

      tokenBtn.addEventListener('click', () => {
        const t = tokenInput.value;
        if (t === EMBEDDED_TOKEN) {
          setToken(t);
          authScreen.style.display = 'none';
          dashScreen.style.display = 'block';
          authed = true;
          init();
        } else {
          authError.style.display = 'block';
          tokenInput.value = '';
          tokenInput.focus();
        }
      });
      tokenInput.addEventListener('keydown', (e) => { if (e.key === 'Enter') tokenBtn.click(); });

      logoutBtn.addEventListener('click', () => {
        clearToken(); authed = false;
        dashScreen.style.display = 'none';
        authScreen.style.display = 'block';
        authError.style.display = 'none'; tokenInput.value = '';
      });

      tabBtns.forEach(b => {
        b.addEventListener('click', () => {
          tabBtns.forEach(x => x.classList.remove('active'));
          b.classList.add('active');
          Object.values(tabContents).forEach(c => c.classList.remove('active'));
          const t = tabContents[b.dataset.tab];
          if (t) t.classList.add('active');
        });
      });

      function loadLocal() {
        try {
          const saved = localStorage.getItem(PHOTOS_KEY);
          if (saved) { const p = JSON.parse(saved); if (p.length) photos = p; }
        } catch {}
        try {
          const saved = localStorage.getItem(THOUGHTS_KEY);
          if (saved) { const t = JSON.parse(saved); if (t.length) { thoughts = t; renderThoughts(); } }
        } catch {}
      }

      function persistLocal() {
        try { localStorage.setItem(PHOTOS_KEY, JSON.stringify(photos)); } catch {}
        try { localStorage.setItem(THOUGHTS_KEY, JSON.stringify(thoughts)); } catch {}
      }

      async function init() {
        skeletonGrid.style.display = 'grid';
        photoGrid.style.display = 'none';
        loadLocal();
        renderThoughts();
        await loadFromServer();
      }

      async function loadFromServer() {
        try {
          const r = await fetch('/api/config');
          if (!r.ok) throw new Error('fetch failed');
          const data = await r.json();
          if (data.photos && data.photos.length) { photos = data.photos; }
          if (data.thoughts && data.thoughts.length) { thoughts = data.thoughts; renderThoughts(); }
          persistLocal();
        } catch { /* use build-time or local data */ }
        skeletonGrid.style.display = 'none';
        photoGrid.style.display = 'grid';
        renderPhotos();
      }

      async function apiCall(url, body) {
        const tok = getToken();
        if (!tok) { showToast('not authenticated', true); return null; }
        try {
          const r = await fetch(url, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${tok}` },
            body: JSON.stringify(body),
          });
          if (r.status === 401) { showToast('token rejected, re-login needed', true); clearToken(); authScreen.style.display = 'block'; dashScreen.style.display = 'none'; return null; }
          return await r.json();
        } catch {
          showToast('server not reachable', true);
          return null;
        }
      }

      // ─── P H O T O S ───

      function esc(s) {
        const d = document.createElement('div');
        d.textContent = s;
        return d.innerHTML;
      }

      function renderPhotos() {
        photoCount.textContent = `(${photos.length})`;

        if (photos.length === 0) {
          photoGrid.innerHTML = '<div class="empty-state">no photos yet! go touch grass 🌿</div>';
          return;
        }

        photoGrid.innerHTML = '';

        photos.forEach((p, i) => {
          const card = document.createElement('div');
          card.className = 'photo-card';
          card.style.animationDelay = `${(i % 6) * 0.05}s`;

          card.innerHTML = `
            <div class="thumb-wrap">
              <img src="${esc(p.path)}" alt="${esc(p.caption)}" loading="lazy" onerror="this.src='data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 400 300%22%3E%3Crect fill=%22%23ffafcc%22 width=%22400%22 height=%22300%22/%3E%3Ctext x=%22200%22 y=%22150%22 text-anchor=%22middle%22 fill=%22%23fff%22 font-size=%2220%22 font-family=%22sans-serif%22%3E?%3C/text%3E%3C/svg%3E'" />
            </div>
            <div class="body">
              <input class="cap" value="${esc(p.caption)}" data-idx="${i}" placeholder="caption" />
              <div class="meta">${esc(p.path)}</div>
              <div class="actions">
                <button class="btn btn-sky btn-sm" data-action="up" data-idx="${i}">↑</button>
                <button class="btn btn-sky btn-sm" data-action="down" data-idx="${i}">↓</button>
                <button class="btn btn-rose btn-sm" data-action="del" data-idx="${i}">✕</button>
              </div>
            </div>
          `;

          // caption input
          const capInput = card.querySelector('.cap');
          capInput.addEventListener('input', () => {
            const idx = parseInt(capInput.dataset.idx || '0');
            if (photos[idx]) photos[idx].caption = capInput.value;
          });

          // action buttons
          card.querySelectorAll('[data-action]').forEach(btn => {
            btn.addEventListener('click', () => {
              const idx = parseInt(btn.dataset.idx || '0');
              const action = btn.dataset.action;
              if (action === 'del') {
                photos.splice(idx, 1);
                renderPhotos();
                showToast('photo yeeted 🗑️');
              } else if (action === 'up' && idx > 0) {
                [photos[idx-1], photos[idx]] = [photos[idx], photos[idx-1]];
                renderPhotos();
              } else if (action === 'down' && idx < photos.length - 1) {
                [photos[idx], photos[idx+1]] = [photos[idx+1], photos[idx]];
                renderPhotos();
              }
            });
          });

          photoGrid.appendChild(card);
        });
      }

      addToggle.addEventListener('click', () => {
        addForm.classList.toggle('open');
        if (addForm.classList.contains('open')) fileInput.focus();
      });

      fileInput.addEventListener('change', () => {
        if (fileInput.files.length) {
          fileLabel.textContent = '📁 ' + fileInput.files[0].name;
          fileLabel.classList.add('has-file');
        }
      });

      addBtn.addEventListener('click', async () => {
        const file = fileInput.files[0];
        const caption = addCap.value.trim() || (file ? file.name.replace(/\.[^.]+$/, '') : 'untitled');
        let path = '';

        if (file) {
          const tok = getToken();
          if (!tok) { showToast('not authenticated', true); return; }
          const formData = new FormData();
          formData.append('photo', file);
          try {
            const r = await fetch('/api/upload', {
              method: 'POST',
              headers: { 'Authorization': `Bearer ${tok}` },
              body: formData,
            });
            if (r.status === 401) { showToast('token rejected', true); return; }
            path = (await r.json()).path;
          } catch {
            showToast('upload failed — is the server running?', true);
            return;
          }
        }

        photos.push({ path, caption });
        renderPhotos();
        fileInput.value = ''; fileLabel.textContent = '📁 choose file...'; fileLabel.classList.remove('has-file');
        addCap.value = ''; addForm.classList.remove('open');
        showToast('photo added! 🎉');
      });

      savePhotosBtn.addEventListener('click', async () => {
        const result = await apiCall('/api/save-photos', { photos });
        if (result) { persistLocal(); showToast('photos saved! ✨'); }
      });

      exportBtn.addEventListener('click', () => {
        const blob = new Blob([JSON.stringify({ photos }, null, 2)], { type: 'application/json' });
        const a = document.createElement('a');
        a.href = URL.createObjectURL(blob); a.download = 'photos.json'; a.click();
        URL.revokeObjectURL(a.href);
        showToast('config exported ⬇');
      });

      // ─── T H O U G H T S ───

      function renderThoughts() {
        thoughtCount.textContent = `(${thoughts.length})`;
        thoughtsArea.value = thoughts.join('\n');
      }

      thoughtsArea.addEventListener('input', () => {
        thoughts = thoughtsArea.value.split('\n').filter(l => l.trim());
      });

      saveThoughtsBtn.addEventListener('click', async () => {
        const result = await apiCall('/api/save-thoughts', { thoughts });
        if (result) { persistLocal(); showToast('thoughts saved! ✨'); }
      });
    })();
  </script>
</BaseLayout>
