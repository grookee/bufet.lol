---
import site from "../../config/site.json";
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import StickyNotes from "../components/StickyNotes.astro";
import Footer from "../components/Footer.astro";

const notes = [
    {
        text: "nice",
        top: "5%",
        left: "3%",
        rot: -15,
        color: "#a2d2ff",
        delay: 0,
    },
    {
        text: "lol",
        top: "3%",
        right: "5%",
        rot: 12,
        color: "#cdb4db",
        delay: 0.8,
    },
    {
        text: "sex",
        bottom: "12%",
        right: "4%",
        rot: -8,
        color: "#bde0fe",
        delay: 1.6,
    },
    {
        text: "wow",
        top: "50%",
        left: "1%",
        rot: 20,
        color: "#ffc8dd",
        delay: 2.4,
    },
    {
        text: "same",
        bottom: "4%",
        left: "35%",
        rot: -10,
        color: "#a2d2ff",
        delay: 3.2,
    },
];
---

<BaseLayout>
    <Header
        title={site.title}
        subtitle={site.subtitle}
        tagline={site.tagline}
    />

    <div class="collage" id="collage"></div>

    <StickyNotes notes={notes} />

    <div id="drunk-thought"></div>
    <div id="sparkle-container"></div>

    <Footer />

    <style>
        .collage {
            position: relative; z-index: 2;
            max-width: 1400px;
            margin: 0 auto;
            padding: 1rem 1.5rem 4rem;
            column-count: 3;
            column-gap: 1.5rem;
        }

        @media (max-width: 1024px) { .collage { column-count: 2; } }
        @media (max-width: 640px)  { .collage { column-count: 1; } }

        .collage-empty {
            grid-column: 1 / -1;
            text-align: center;
            padding: 3rem 1rem;
            color: rgba(255, 255, 255, 0.8);
            font-family: "Fredoka", sans-serif;
            font-weight: 700;
            font-size: 1.2rem;
        }

        .polaroid {
            display: inline-block;
            width: 100%;
            margin-bottom: 1.5rem;
            break-inside: avoid;
            background: #fff;
            padding: .75rem .75rem 2.2rem;
            border-radius: 3px;
            box-shadow: 0 8px 20px rgba(0,0,0,.12), 0 2px 6px rgba(0,0,0,.06);
            transition: transform .3s cubic-bezier(.34,1.56,.64,1), box-shadow .3s ease;
            position: relative;
        }

        .polaroid:hover {
            transform: scale(1.03) rotate(var(--hover-rot,0deg)) !important;
            box-shadow: 0 14px 35px rgba(0,0,0,.18), 0 4px 10px rgba(0,0,0,.1);
        }

        .polaroid img {
            width: 100%; height: auto; display: block; border-radius: 2px;
            aspect-ratio: auto;
        }

        .polaroid .caption {
            font-weight: 700;
            font-size: 1rem;
            text-align: center;
            margin-top: .55rem;
            color: #444;
            letter-spacing: .02em;
            text-transform: lowercase;
        }

        .polaroid .tape {
            position: absolute;
            top: 6px; left: 50%;
            width: 80px; height: 14px;
            margin-left: -40px;
            background: rgba(255,255,255,.55);
            border-radius: 2px;
            box-shadow: 0 1px 3px rgba(0,0,0,.08);
            transform: rotate(-3deg);
            pointer-events: none;
        }
    </style>

    <script>
        const rotations = [
            { rot: -2, hoverRot: -1 },
            { rot: 3,  hoverRot:  1 },
            { rot: -4, hoverRot: -2 },
            { rot: 5,  hoverRot:  2 },
            { rot: -3, hoverRot: -1 },
            { rot: 2,  hoverRot:  1 },
            { rot: -6, hoverRot: -3 },
            { rot: 4,  hoverRot:  2 },
        ];

        // ── s p i l l  e f f e c t ──
        (function spill() {
            const colors = ["#cdb4db", "#ffc8dd", "#bde0fe", "#a2d2ff"];
            for (let i = 0; i < 8; i++) {
                const dot = document.createElement("div");
                const size = 4 + Math.random() * 20;
                dot.style.cssText = `
          position: fixed; z-index: 0; pointer-events: none; opacity: 0.25; border-radius: 50%;
          width: ${size}px; height: ${size * (0.6 + Math.random() * 0.8)}px;
          background: ${colors[i % colors.length]};
          top: ${Math.random() * 100}%; left: ${Math.random() * 100}%;
          transform: rotate(${Math.random() * 360}deg);
        `;
                document.body.appendChild(dot);
            }
        })();

        // ── d a t a  l o a d e r  (photos + thoughts from API) ──
        (async function load() {
            let photos = [];
            let thoughts = [];

            try {
                const r = await fetch("/api/config");
                if (r.ok) {
                    const d = await r.json();
                    photos = Array.isArray(d.photos) ? d.photos : [];
                    thoughts = Array.isArray(d.thoughts) ? d.thoughts : [];
                    localStorage.setItem("bufet_thoughts", JSON.stringify(thoughts));
                }
            } catch {}

            if (!thoughts.length) {
                try {
                    const cached = JSON.parse(localStorage.getItem("bufet_thoughts") || "[]");
                    if (Array.isArray(cached) && cached.length) thoughts = cached;
                } catch {}
            }

            renderCollage(photos);
            initThoughts(thoughts);
        })();

        function esc(s) {
            const d = document.createElement("div");
            d.textContent = String(s ?? "");
            return d.innerHTML;
        }

        function renderCollage(photos) {
            const el = document.getElementById("collage");
            if (!el) return;

            if (!photos.length) {
                el.innerHTML = '<div class="collage-empty">még nincs itt semmi 🌱</div>';
                return;
            }

            el.innerHTML = "";
            photos.forEach((p, i) => {
                const r = rotations[i % rotations.length];
                const card = document.createElement("div");
                card.className = "polaroid";
                card.style.transform = `rotate(${r.rot}deg)`;
                card.style.setProperty("--hover-rot", `${r.hoverRot}deg`);
                card.innerHTML = `
              <img src="${esc(p.path)}" alt="${esc(p.caption)}" loading="lazy" />
              <div class="caption">${esc(p.caption)}</div>
              <div class="tape"></div>
            `;
                el.appendChild(card);
            });
        }

        // ── d r u n k  t h o u g h t s ──
        function initThoughts(list) {
            const el = document.getElementById("drunk-thought");
            if (!el) return;
            const pick = () => {
                if (!list || !list.length) return;
                el.textContent = list[Math.floor(Math.random() * list.length)];
                el.style.opacity = "1";
                setTimeout(() => {
                    el.style.opacity = "0";
                }, 5000);
            };
            pick();
            setInterval(pick, 10000);
            el.style.cssText = `
        position: fixed; z-index: 20; bottom: 5rem; left: 50%; transform: translateX(-50%);
        background: rgba(255,255,255,.85); backdrop-filter: blur(4px);
        color: #555; font-family: 'Nunito', sans-serif; font-weight: 700; font-size: .95rem;
        padding: .6rem 1.2rem; border-radius: 999px; box-shadow: 0 4px 16px rgba(0,0,0,.1);
        transition: opacity .6s; opacity: 0; max-width: 90vw; white-space: nowrap;
      `;
        }

        // ── s p a r k l e  o n  s c r o l l ──
        (function sparkle() {
            const container = document.getElementById("sparkle-container");
            if (!container) return;
            const symbols = ["✦", "✧", "･", "⋆", "·", "✶"];
            let ticking = false;
            const spawn = () => {
                const s = document.createElement("span");
                s.textContent =
                    symbols[Math.floor(Math.random() * symbols.length)];
                s.style.cssText = `
          position: fixed; pointer-events: none; z-index: 15;
          font-size: ${8 + Math.random() * 16}px;
          color: ${["#ffc8dd", "#bde0fe", "#a2d2ff", "#fff"][Math.floor(Math.random() * 4)]};
          left: ${Math.random() * 100}vw;
          top: -20px;
          animation: sparkleFall ${2 + Math.random() * 2}s linear forwards;
        `;
                container.appendChild(s);
                setTimeout(() => s.remove(), 4000);
            };
            const style = document.createElement("style");
            style.textContent = `
        @keyframes sparkleFall {
          0% { transform: translateY(0) rotate(0deg); opacity: 1; }
          100% { transform: translateY(110vh) rotate(360deg); opacity: 0; }
        }
      `;
            document.head.appendChild(style);
            window.addEventListener("scroll", () => {
                if (!ticking) {
                    requestAnimationFrame(() => {
                        spawn();
                        ticking = false;
                    });
                    ticking = true;
                }
            });
            setTimeout(spawn, 1000);
            setTimeout(spawn, 2000);
        })();

        // ── r a n d o m  w i g g l e ──
        (function wiggle() {
            const style = document.createElement("style");
            style.textContent = `
        @keyframes randomWiggle {
          0%, 100% { transform: rotate(var(--rot,0deg)); }
          25% { transform: rotate(calc(var(--rot,0deg) + 1.5deg)); }
          75% { transform: rotate(calc(var(--rot,0deg) - 1.5deg)); }
        }
      `;
            document.head.appendChild(style);
            setInterval(() => {
                document.querySelectorAll(".polaroid").forEach((p) => {
                    if (Math.random() > 0.15) return;
                    p.style.animation = "none";
                    void p.offsetHeight;
                    p.style.animation = `randomWiggle 0.3s ease 2`;
                    setTimeout(() => {
                        p.style.animation = "";
                    }, 600);
                });
            }, 4000);
        })();
    </script>
</BaseLayout>
