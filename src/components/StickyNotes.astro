---
export interface Note {
  text: string;
  top?: string;
  left?: string;
  right?: string;
  bottom?: string;
  rot: number;
  color: string;
  delay: number;
}

export interface Props {
  notes: Note[];
}

const { notes } = Astro.props;
---

<style>
  .sticky {
    position: fixed; z-index: 10;
    font-family: 'Fredoka', sans-serif;
    font-weight: 600;
    font-size: clamp(1.4rem,3vw,2.4rem);
    padding: .6rem 1.2rem;
    border-radius: 4px;
    box-shadow: 0 4px 12px rgba(0,0,0,.12), inset 0 -2px 0 rgba(0,0,0,.06);
    pointer-events: none;
    animation: float 5s ease-in-out infinite;
  }

  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50%      { transform: translateY(-10px); }
  }
</style>

{notes.map((n) => (
  <div
    class="sticky"
    style={{
      top: n.top,
      left: n.left,
      right: n.right,
      bottom: n.bottom,
      background: n.color,
      rotate: `${n.rot}deg`,
      animationDelay: `${n.delay}s`,
    }}
  >
    {n.text}
  </div>
))}
