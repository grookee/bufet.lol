---
export interface Props {
  src: string;
  caption: string;
  alt?: string;
  rot?: number;
  hoverRot?: number;
}

const { src, caption, alt = caption, rot = 0, hoverRot = 0 } = Astro.props;
---

<style>
  .polaroid {
    display: inline-block;
    width: 100%;
    margin-bottom: 1.5rem;
    break-inside: avoid;
    background: #fff;
    padding: .75rem .75rem 2.2rem;
    border-radius: 3px;
    box-shadow: 0 8px 20px rgba(0,0,0,.12), 0 2px 6px rgba(0,0,0,.06);
    transition: transform .3s cubic-bezier(.34,1.56,.64,1), box-shadow .3s ease;
    position: relative;
  }

  .polaroid:hover {
    transform: scale(1.03) rotate(var(--hover-rot,0deg)) !important;
    box-shadow: 0 14px 35px rgba(0,0,0,.18), 0 4px 10px rgba(0,0,0,.1);
  }

  .polaroid img {
    width: 100%; height: auto; display: block; border-radius: 2px;
    aspect-ratio: auto;
  }

  .caption {
    font-weight: 700;
    font-size: 1rem;
    text-align: center;
    margin-top: .55rem;
    color: #444;
    letter-spacing: .02em;
    text-transform: lowercase;
  }

  .tape {
    position: absolute;
    top: 6px; left: 50%;
    width: 80px; height: 14px;
    margin-left: -40px;
    background: rgba(255,255,255,.55);
    border-radius: 2px;
    box-shadow: 0 1px 3px rgba(0,0,0,.08);
    transform: rotate(-3deg);
    pointer-events: none;
  }
</style>

<div class="polaroid" style={`transform: rotate(${rot}deg); --hover-rot: ${hoverRot}deg;`}>
  <img src={src} alt={alt} loading="lazy" />
  <div class="caption">{caption}</div>
  <div class="tape"></div>
</div>
